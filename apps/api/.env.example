# =========================
# Server
# =========================
PORT=3001
ENVIRONMENT=development
# CSV de origens permitidas. Em prod: https://app.plenyasaude.com.br,https://plenyasaude.com.br
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# =========================
# Database (PostgreSQL 17 + pgvector)
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=plenya_user
DB_PASSWORD=plenya_dev_password
DB_NAME=plenya_db
DB_SSL_MODE=disable

# =========================
# JWT
# =========================
# Em prod, gerar 32+ bytes random. Ex: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_256_bits_minimum_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# =========================
# Criptografia (CPF/RG, LGPD)
# =========================
# OBRIGATÓRIO 32 chars exatos. Em prod: openssl rand -hex 16
ENCRYPTION_KEY=your_encryption_key_256_bits_here

# =========================
# Rate limiting
# =========================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =========================
# SNCR (Anvisa)
# =========================
SNCR_ENABLED=true
SNCR_PRODUCTION_MODE=false
SNCR_API_URL=https://sncr.anvisa.gov.br/api/v1
SNCR_API_KEY=

# =========================
# AI / RAG
# =========================
CLAUDE_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_API_URL=https://api.openai.com/v1

# =========================
# Email (Resend, transacional)
# =========================
RESEND_API_KEY=
EMAIL_FROM=Plenya <noreply@plenyasaude.com.br>
# Fallback SMTP se Resend não configurado
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# =========================
# Mail Ingest (IMAP IDLE worker — Stalwart self-hosted)
# Espelha emails inbound (e Sent mirror) como LeadActivity no CRM.
# Quando ENABLED=false, o worker faz no-op (sem conectar).
# =========================
MAIL_INGEST_ENABLED=false
MAIL_INGEST_IMAP_HOST=mail.plenyasaude.com.br
MAIL_INGEST_IMAP_PORT=993
MAIL_INGEST_USERNAME=contato@plenyasaude.com.br
MAIL_INGEST_PASSWORD=
# CSV — INBOX captura inbound; "Sent Items" espelha replies feitas pelo iPhone/cliente externo
MAIL_INGEST_FOLDERS=INBOX,Sent Items
MAIL_INGEST_MAX_ATTACHMENT_MB=50
MAIL_INGEST_ATTACHMENT_DIR=/app/uploads/email-attachments

# =========================
# WhatsApp Business (Meta Cloud API) — Fase 1+2 CRM
# =========================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_MAGIC_LINK=magic_link
WHATSAPP_TEMPLATE_LEAD_ALERT=lead_alert

# =========================
# Site público (URLs)
# =========================
SITE_PUBLIC_URL=https://plenyasaude.com.br

# =========================
# CRM (Fase 2)
# =========================
# URL base do EMR pra link nas notificações
CRM_ADMIN_URL=https://app.plenyasaude.com.br
# CSV de UUIDs de User pra notificar leads novos. Vazio = fallback (todos staff admin/secretary/manager)
CRM_LEAD_NOTIFY_USER_IDS=

# =========================
# Google Calendar (V1 — integração agenda do médico)
# Distinto de OAUTH_GOOGLE_CLIENT_ID (Sign-in). Esse projeto Cloud é dedicado pro
# scope `calendar.events.owned`. Quando vazio, /integrations/google/* retorna 503.
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://app.plenyasaude.com.br/api/v1/integrations/google/callback

# =========================
# Daily.co (teleconsulta embedada)
# Quando API_KEY vazio, criação de sala falha graciosamente — appointment ainda
# é criado, mas sem URL de telemedicina (caller decide se bloqueia o tipo).
# =========================
DAILY_CO_API_KEY=
DAILY_CO_DOMAIN=plenya

# Web Push (VAPID) — gere com webpush.GenerateVAPIDKeys(); vazio = Web Push desligado
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=contato@plenyasaude.com.br
