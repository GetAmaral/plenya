    "zod": "^4.3.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "^19.0.7",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3"
  }
